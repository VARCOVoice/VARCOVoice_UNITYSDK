/* ==================== Wavetable Waveform Styles ==================== */

/* Container */
.wavetable {
    width: 264px;
    height: 86px;
    position: relative;
}

/* Display Area */
.wavetable__display {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}

/* Waveform Fill (Background) */
.wavetable__fill {
    width: 100%;
    height: 100%;
    position: absolute;
    opacity: 0.3;
    background-color: var(--varco-mint);
}

/* Waveform Path (Line) */
.wavetable__path {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* ==================== Waveform Shape Variants ==================== */

/* Complex Saw */
.wavetable--complex-saw .wavetable__path {
    /* Custom vector path rendering needed */
}

/* Simple Sine */
.wavetable--simple-sine .wavetable__path {
    /* Custom vector path rendering needed */
}

/* Noise */
.wavetable--noise .wavetable__path {
    /* Custom vector path rendering needed */
}

/* ==================== Filter Curve ==================== */

.wavetable--filter {
    width: 176px;
    height: 63px;
}

/* ==================== Random Curve ==================== */

.wavetable--random {
    width: 337px;
    height: 82px;
}
