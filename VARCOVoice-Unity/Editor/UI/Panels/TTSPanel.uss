/* ==================== TTS Panel Pro Styles ==================== */
/* Linear Layout - Line Separated Sections */
/* Unity UI Toolkit Safe */

/* ========== Root Panel ========== */
.tts-panel {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    padding: 0;
    overflow: hidden;
}

.tts-content {
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    padding: 0;
    overflow: hidden;
}

/* ================================================================================== */
/* ============================= LEFT SECTION ======================================= */
/* ================================================================================== */

.tts-control-section {
    width: 340px;
    height: 100%;
    flex-shrink: 0;
    background-color: var(--bg-secondary);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.15); /* Stronger border for linear look */
    padding: 12px;
    flex-direction: column;
    overflow: hidden;
}

/* Module Voice */
.module--voice {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 150px;
}

/* Module Params - FIXED height to prevent squashing */
.module--params {
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 8px;
    margin-bottom: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    height: 150px;
}

.module {
    margin-bottom: 8px;
    background-color: transparent;
    border-width: 0;
}

.module__title {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

/* Filter Row */
.filter-row {
    flex-direction: row;
    margin-bottom: 8px;
    margin-left: 8px;
    margin-right: 8px;
    width: auto;
    flex-shrink: 0;
    overflow: hidden; /* Prevent children from overflowing */
}

.filter-btn {
    flex-grow: 1;
    height: 24px;
    background-color: transparent; /* Linear style */
    border-radius: 0px; /* Square */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-right: -1px; /* Fuse borders */
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    -unity-font-style: bold;
}

.filter-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}

.filter-btn.filter-btn--active {
    background-color: rgba(0, 110, 255, 0.15);
    border-color: #006EFF;
    color: #006EFF;
}

.filter-select {
    width: 80px;
    height: 24px;
    margin-left: -1px; /* Fuse borders */
    margin-right: 0px;
}

/* First dropdown should not have negative margin - show full left border */
.filter-row > .filter-select:first-child {
    margin-left: 0;
}

.filter-select .unity-base-field__input {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
    border-width: 1px;
    border-radius: 0px;
    margin: 0;
    padding: 2px 4px;
    color: rgba(255, 255, 255, 0.9);
}

.filter-select .unity-base-popup-field__input {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
    border-width: 1px;
    border-radius: 0px;
    margin: 0;
    padding: 2px 4px;
    color: rgba(255, 255, 255, 0.9);
}

.filter-select:hover .unity-base-popup-field__input {
    border-color: rgba(255, 255, 255, 0.6);
}

/* Compact dropdown variant - smaller width */
.filter-select--sm {
    width: 60px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 50px;
}

.filter-select--sm .unity-base-popup-field__input {
    padding: 1px 2px;
    font-size: 10px;
}

/* Extra-small variant for language dropdown */
.filter-select--xs {
    width: 38px;
    flex-grow: 0;
    flex-shrink: 0;
}

.filter-select--xs .unity-base-popup-field__input {
    padding: 1px 2px;
    font-size: 10px;
}


.icon-btn {
    width: 24px;
    margin-left: -1px;
    margin-right: 2px; /* Fix clipping */
}

/* Voice Search */
.voice-search {
    margin: 4px 8px 8px 8px;
    height: 28px;
    flex-shrink: 0;
    min-height: 28px;
}

/* 검색창 입력 필드 스타일 - 실제 색상값 사용 */
.voice-search .unity-text-field__input {
    background-color: var(--bg-control);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 0px;
    padding: 3px 6px;
    font-size: 11px;
    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.voice-search:focus .unity-text-field__input {
    border-color: #006EFF;
}

/* ID 기반 선택자로 높은 우선순위 */
#voice-search {
    height: 28px;
    min-height: 28px;
}

#voice-search .unity-text-field__input {
    background-color: var(--bg-control);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 0px;
    padding: 3px 6px;
    color: var(--text-primary);
}


/* Voice List */
.voice-list {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--border-subtle);
    margin-bottom: 8px;
}

/* Voice Item in List */
.voice-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    background-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle); /* Divider */
    height: 40px;
}
.voice-item:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.voice-item__info {
    flex-direction: row;
    align-items: center;
    margin-bottom: 0;
    flex-grow: 1;
    overflow: hidden;
    margin-right: 8px;
}

.voice-item__name {
    font-size: 13px;
    color: var(--text-primary);
    -unity-font-style: bold;
    flex-shrink: 0; 
}

.voice-item__tags {
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 8px;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis; 
    white-space: nowrap;
}

.voice-item__actions {
    flex-direction: row;
    margin-top: 0;
    flex-shrink: 0;
    align-items: center;
}

.voice-item__btn {
    width: 24px;
    height: 24px;
    border-radius: 0px; /* Square */
    border-width: 1px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 4px;
    background-color: transparent;
    padding: 0; /* Important */
}

/* A Button Style - Blue (#006EFF) */
.voice-item__btn--a {
    border-color: rgba(0, 110, 255, 0.5);
    background-color: rgba(0, 110, 255, 0.05);
    color: #4D9EFF;
}
.voice-item__btn--a:hover {
    background-color: rgba(0, 110, 255, 0.2);
    border-color: #006EFF;
    color: #FFFFFF;
}
.voice-item__btn--a.selected {
    background-color: #006EFF;
    border-color: #006EFF;
    color: #FFFFFF;
}

/* B Button Style - Red (#FF4444) */
.voice-item__btn--b {
    margin-right: 0;
    border-color: rgba(255, 68, 68, 0.5);
    background-color: rgba(255, 68, 68, 0.05);
    color: #FF8888;
}
.voice-item__btn--b:hover {
    background-color: rgba(255, 68, 68, 0.2);
    border-color: #FF4444;
    color: #FFFFFF;
}
.voice-item__btn--b.selected {
    background-color: #FF4444;
    border-color: #FF4444;
    color: #FFFFFF;
}

/* Selected Voices A/B Row */
.selected-voices-row {
    flex-direction: row;
    padding-top: 10px; /* Increased top padding */
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    width: 100%;
    flex-shrink: 0;
}

.selected-slot {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    background-color: #151921;
    padding: 6px 8px;
    border-radius: 0px; /* Square */
    margin-right: 4px;
    border-left-width: 3px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    height: 32px;
}

.selected-slot--b { 
    margin-right: 0;
    border-left-color: rgba(255, 255, 255, 0.5);
}
.selected-slot--a { 
    border-left-color: #006EFF;
}

.selected-slot__badge {
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 8px;
    color: rgba(255, 255, 255, 0.9);
    width: 16px;
}
.selected-slot__name {
    flex-grow: 1;
    font-size: 12px;
    color: #FFFFFF;
    overflow: hidden;
    -unity-text-align: middle-left;
    min-width: 50px; /* Prevent collapse */
    white-space: nowrap;
}
.selected-slot__clear {
    width: 20px;
    height: 20px;
    background-color: transparent;
    border-width: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    padding: 0;
}
.selected-slot__clear:hover { 
    color: #FF4444; 
}


/* Knobs Row */
.knobs-row {
    flex-direction: row;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0,0,0,0.1);
    border-radius: 0px; /* Square */
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}
.rotary-knob {
    align-items: center;
    width: auto;
    min-width: 80px;
    flex-direction: column;
    flex-grow: 1;
}

/* DSP Plugin Style Implementation */
.rotary-knob__dial-container {
    width: 60px;
    height: 60px;
    position: relative;
    margin-bottom: 8px;
    flex-shrink: 0;
}

/* Knob Track (Background) */
.rotary-knob__track {
    width: 100%;
    height: 100%;
    position: absolute;
    border-radius: 50%;
    background-color: #1E1E1E;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

/* Knob Indicator (White Pill) */
.rotary-knob__indicator {
    width: 4px;
    height: 14px;
    background-color: #006EFF; /* Blue indicator now */
    position: absolute;
    left: 50%;
    top: 6px;
    translate: -50% 0;
    border-radius: 1px;
}

/* Active Arc */
.rotary-knob__progress-arc {
    width: 100%;
    height: 100%;
    position: absolute;
    border-radius: 50%;
}

.rotary-knob__label {
    background-color: transparent;
    border-radius: 0px;
    border-width: 0;
    padding: 2px 4px;
    margin-bottom: 4px;
    justify-content: center;
    width: 60px;
}
.rotary-knob__label-text {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}
.rotary-knob__value {
    font-size: 11px;
    color: #006EFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hidden-slider { display: none; }
.hidden-control { display: none; }


/* ================================================================================== */
/* ======================== RIGHT SECTION (Linear Layout) =========================== */
/* ================================================================================== */


.tts-right-section {
    flex-grow: 1;
    background-color: var(--bg-dark);
    padding: 12px;
    flex-direction: column;
    overflow: hidden;
}

/* Section Container */
.tts-section {
    flex-direction: column;
    background-color: transparent;
    padding: 0;
    margin-bottom: 0;
}

.session-section {
    flex-grow: 1;
    min-height: 150px;
}

/* Section Header Row */
.section-header-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15); /* Stronger */
}

.section-title {
    font-size: 11px;
    color: #006EFF; /* Blue */
    -unity-font-style: bold;
}

.section-header-spacer {
    flex-grow: 1;
}

.section-stat {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-left: 12px;
}

/* Section Divider */
.section-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-top: 12px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

/* Input Area */
.input-area {
    min-height: 100px;
    background-color: var(--bg-control);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 0px; /* Square */
    margin-bottom: 8px;
}

.tts-text-input {
    flex-grow: 1;
    height: 100%;
    width: 100%;
    margin: 0;
    border-width: 0;
}
.tts-text-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-primary);
    font-size: 13px;
    -unity-font-style: normal;
    padding: 12px;
    white-space: normal;
}

/* Button Row */
.button-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.btn-primary {
    height: 30px;
    min-width: 120px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(0, 110, 255, 0.15);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(0, 110, 255, 0.5);
    color: #4D9EFF;
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: auto;
}
.btn-primary:hover {
    background-color: rgba(0, 110, 255, 0.25);
    border-color: #006EFF;
    color: #FFFFFF;
}
.btn-primary:active {
    background-color: rgba(0, 110, 255, 0.4);
}


/* Waveform Container */
.waveform-container {
    flex-grow: 1;
    min-height: 80px;
    background-color: var(--bg-card);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 0px; /* Square */
    margin-bottom: 8px;
    position: relative;
    overflow: hidden;
}

/* New Content Wrapper for Zoom */
.waveform-content {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%; /* Default width, will be modified by C# for zoom */
    flex-direction: row;
}

.waveform-image {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 0;
    right: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.playhead-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.waveform-playhead {
    width: 1px; /* Thinner */
    height: 100%;
    background-color: #006EFF; /* Blue playhead */
    position: absolute;
}

.time-display {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 12px;
    color: #FFFFFF;
    background-color: rgba(0, 110, 255, 0.2);
    padding: 2px 6px;
    border-radius: 0px;
}


/* ================================================================================== */
/* =========================== UNIFIED PLAYBACK CONTROLS ============================ */
/* ================================================================================== */

.playback-controls {
    flex-direction: column;
    background-color: transparent; /* Line style - no box */
    border-radius: 0px;
    padding: 8px 0; /* Only vertical padding */
    margin-top: auto;
    border-width: 0;
    border-top-width: 1px; /* Only top border as separator */
    border-color: rgba(255, 255, 255, 0.1);
}

.controls-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin-bottom: 6px;
}
/* Removed :last-child as it is not supported in Unity 2021/2022 UI Toolkit */

.controls-spacer {
    flex-grow: 1;
}

/* Control Buttons */
.ctrl-btn {
    height: 28px;
    min-width: 50px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: transparent; /* Linear */
    border-radius: 0px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 4px; /* Add spacing between buttons */
    flex-shrink: 0;
}
.ctrl-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.4);
}

.ctrl-btn--play {
    background-color: rgba(0, 110, 255, 0.1);
    border-width: 1px;
    border-color: rgba(0, 110, 255, 0.4);
    color: #4D9EFF;
    width: 60px;
}
.ctrl-btn--play:hover {
    background-color: rgba(0, 110, 255, 0.25);
    color: #FFFFFF;
    border-color: #006EFF;
}

.ctrl-btn--sm {
    min-width: 32px;
    height: 28px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    flex-grow: 0;
}
.ctrl-btn--sm:hover {
    border-color: #006EFF;
    color: #006EFF;
}

/* Specific A/B Styles */
#play-a-btn {
    width: 40px;
    border-color: rgba(0, 110, 255, 0.5);
    color: #006EFF;
    background-color: rgba(0, 110, 255, 0.1);
}
#play-a-btn:hover, #play-a-btn.selected {
    background-color: #006EFF;
    color: #FFFFFF;
    border-color: #006EFF;
}

#play-b-btn {
    width: 40px;
    border-color: rgba(255, 68, 68, 0.5);
    color: #FF4444;
    background-color: rgba(255, 68, 68, 0.1);
}
#play-b-btn:hover, #play-b-btn.selected {
    background-color: #FF4444;
    color: #FFFFFF;
    border-color: #FF4444;
}

#play-ab-btn {
    width: 44px;
    color: rgba(255, 255, 255, 0.85);
}
#play-ab-btn:hover, #play-ab-btn.selected {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.1);
}

.ctrl-btn--primary {
    background-color: rgba(0, 110, 255, 0.15);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(0, 110, 255, 0.3);
    color: #FFFFFF;
}
.ctrl-btn--primary:hover {
    background-color: rgba(0, 110, 255, 0.3);
    border-color: rgba(0, 110, 255, 0.6);
}

/* A/B Group */
.ab-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 8px;
}

/* Scrub Slider - Playback Style Override */
#playback-scrub,
.scrub-slider,
.playback-scrub {
    flex-grow: 1;
    margin: 0 8px;
    height: 28px; /* 버튼과 같은 높이 */
    align-self: center;
}

#playback-scrub .unity-base-slider__tracker,
.scrub-slider .unity-base-slider__tracker,
.playback-scrub .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    height: 6px;
    top: 50%;
    margin-top: -3px; /* 세로 중앙 정렬 */
    border-width: 0;
}

#playback-scrub .unity-base-slider__tracker-border,
.scrub-slider .unity-base-slider__tracker-border,
.playback-scrub .unity-base-slider__tracker-border {
    display: none;
}

#playback-scrub .unity-base-slider__dragger,
.scrub-slider .unity-base-slider__dragger,
.playback-scrub .unity-base-slider__dragger {
    background-color: #FFFFFF; /* 흰색 */
    width: 6px;
    height: 16px;
    top: 50%;
    margin-top: -8px; /* 세로 중앙 정렬 */
    margin-left: -3px;
    border-radius: 3px;
    border-width: 0;
}

#playback-scrub .unity-base-slider__dragger-border,
.scrub-slider .unity-base-slider__dragger-border,
.playback-scrub .unity-base-slider__dragger-border {
    display: none;
}

#playback-scrub:hover .unity-base-slider__dragger,
.scrub-slider:hover .unity-base-slider__dragger,
.playback-scrub:hover .unity-base-slider__dragger {
    background-color: #006EFF; /* 호버 시 파란색 */
}

/* Legacy support - keep for compatibility */
.transport-row { display: none; }
.ab-row { display: none; }
.ab-hidden { display: none; }
.action-row { display: none; }


/* Light Mode - TTS Panel */
.theme-light .tts-panel {
    background-color: #F4F6F9;
}

.theme-light .tts-control-section {
    background-color: #FFFFFF;
    border-right-color: rgba(15, 23, 42, 0.16);
}

.theme-light .module--params {
    border-top-color: rgba(15, 23, 42, 0.16);
}

.theme-light .module__title {
    color: #4B5563;
}

.theme-light .filter-btn {
    border-color: rgba(15, 23, 42, 0.2);
    color: #6B7280;
}

.theme-light .filter-btn:hover {
    background-color: rgba(15, 23, 42, 0.04);
    color: #1B1F26;
}

.theme-light .filter-btn.filter-btn--active {
    background-color: rgba(0, 102, 221, 0.12);
    border-color: #0066DD;
    color: #0066DD;
}

.theme-light .filter-select .unity-base-field__input,
.theme-light .filter-select .unity-base-popup-field__input {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.2);
    color: #1B1F26;
}

.theme-light .voice-search .unity-text-field__input,
.theme-light #voice-search .unity-text-field__input {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.2);
    color: #1B1F26;
}

.theme-light .voice-list {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.12);
}

.theme-light .voice-item {
    border-bottom-color: rgba(15, 23, 42, 0.08);
}

.theme-light .voice-item:hover {
    background-color: #F3F6FB;
}

.theme-light .voice-item__name {
    color: #111827;
}

.theme-light .voice-item__tags {
    color: #6B7280;
}

.theme-light .voice-item__btn {
    border-color: rgba(15, 23, 42, 0.2);
}

.theme-light .voice-item__btn--a {
    background-color: rgba(0, 102, 221, 0.1);
    border-color: rgba(0, 102, 221, 0.4);
    color: #0066DD;
}

.theme-light .voice-item__btn--a:hover,
.theme-light .voice-item__btn--a.selected {
    background-color: #0066DD;
    border-color: #0066DD;
    color: #FFFFFF;
}

.theme-light .voice-item__btn--b {
    background-color: rgba(229, 57, 53, 0.1);
    border-color: rgba(229, 57, 53, 0.4);
    color: #E53935;
}

.theme-light .voice-item__btn--b:hover,
.theme-light .voice-item__btn--b.selected {
    background-color: #E53935;
    border-color: #E53935;
    color: #FFFFFF;
}

.theme-light .selected-voices-row {
    border-top-color: rgba(15, 23, 42, 0.16);
}

.theme-light .selected-slot {
    background-color: #FFFFFF;
    border-right-color: rgba(15, 23, 42, 0.12);
    border-top-color: rgba(15, 23, 42, 0.12);
    border-bottom-color: rgba(15, 23, 42, 0.12);
}

.theme-light .selected-slot--b {
    border-left-color: rgba(15, 23, 42, 0.4);
}

.theme-light .selected-slot__badge,
.theme-light .selected-slot__name {
    color: #1B1F26;
}

.theme-light .section-header {
    color: #1B1F26;
    border-bottom-color: rgba(15, 23, 42, 0.12);
}

.theme-light .section-title {
    color: #0066DD;
}

.theme-light .section-stat {
    color: #6B7280;
}

.theme-light .section-divider {
    background-color: rgba(15, 23, 42, 0.12);
}

.theme-light .input-area {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.12);
}

.theme-light .tts-text-input .unity-text-field__input {
    color: #111827;
}

.theme-light .btn-primary {
    background-color: #0066DD;
    border-color: #0066DD;
    color: #FFFFFF;
}

.theme-light .btn-primary:hover {
    background-color: #0059C1;
    border-color: #0059C1;
}

.theme-light .waveform-container {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.12);
}

.theme-light .time-display {
    color: #1B1F26;
    background-color: rgba(0, 102, 221, 0.12);
}

.theme-light .playback-controls {
    border-color: rgba(15, 23, 42, 0.16);
}

.theme-light .ctrl-btn {
    border-color: rgba(15, 23, 42, 0.2);
    color: #4B5563;
}

.theme-light .ctrl-btn:hover {
    background-color: rgba(15, 23, 42, 0.04);
    color: #1B1F26;
    border-color: rgba(15, 23, 42, 0.3);
}

.theme-light .ctrl-btn--play {
    background-color: rgba(0, 102, 221, 0.12);
    border-color: rgba(0, 102, 221, 0.4);
    color: #0066DD;
}

.theme-light .ctrl-btn--play:hover {
    background-color: #0066DD;
    border-color: #0066DD;
    color: #FFFFFF;
}

.theme-light #play-a-btn {
    background-color: rgba(0, 102, 221, 0.1);
    border-color: rgba(0, 102, 221, 0.4);
    color: #0066DD;
}

.theme-light #play-a-btn:hover,
.theme-light #play-a-btn.selected {
    background-color: #0066DD;
    border-color: #0066DD;
    color: #FFFFFF;
}

.theme-light #play-b-btn {
    background-color: rgba(229, 57, 53, 0.1);
    border-color: rgba(229, 57, 53, 0.4);
    color: #E53935;
}

.theme-light #play-b-btn:hover,
.theme-light #play-b-btn.selected {
    background-color: #E53935;
    border-color: #E53935;
    color: #FFFFFF;
}

.theme-light #play-ab-btn {
    color: #4B5563;
}

.theme-light #play-ab-btn:hover,
.theme-light #play-ab-btn.selected {
    background-color: rgba(15, 23, 42, 0.06);
    border-color: rgba(15, 23, 42, 0.3);
    color: #1B1F26;
}

.theme-light .ctrl-btn--primary {
    background-color: #0066DD;
    border-color: #0066DD;
    color: #FFFFFF;
}

.theme-light .ctrl-btn--primary:hover {
    background-color: #0059C1;
    border-color: #0059C1;
}

.theme-light #playback-scrub .unity-base-slider__tracker,
.theme-light .scrub-slider .unity-base-slider__tracker,
.theme-light .playback-scrub .unity-base-slider__tracker {
    background-color: rgba(15, 23, 42, 0.12);
}

.theme-light #playback-scrub .unity-base-slider__dragger,
.theme-light .scrub-slider .unity-base-slider__dragger,
.theme-light .playback-scrub .unity-base-slider__dragger {
    background-color: #1B1F26;
}


/* Light Mode - TTS Panel Extras */
.theme-light .selected-slot__clear {
    color: #9AA3AF;
}

.theme-light .selected-slot__clear:hover {
    color: #E53935;
}

.glow-anim {
    border-color: #006EFF;
    border-width: 1px;
    background-color: rgba(0, 110, 255, 0.4);
    color: #FFFFFF;
}
