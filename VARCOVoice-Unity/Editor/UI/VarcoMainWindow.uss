/* ==================== VARCO Voice Main Window Styles ==================== */
/* Unity UI Toolkit Compatible - Variables on Root Elements */

/* ==================== Global Font ==================== */
* {
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Inter/Inter-VariableFont_opsz,wght.ttf');
}

/* ==================== Variables on Main Container ==================== */
.main-container {
    /* Primary Brand Colors */
    --varco-mint: #006EFF;
    --varco-blue: #1F7BFF;
    --varco-purple: #FFFFFF;
    --varco-ink: #000000;
    --varco-white: #FFFFFF;
    
    /* Background Colors */
    --bg-dark: #000000;
    --bg-secondary: #0B0B0B;
    --bg-card: rgba(0, 0, 0, 0.78);
    --bg-elevated: #141414;
    --bg-control: #1E1E1E;
    --bg-control-hover: #2A2A2A;
    
    /* State Colors */
    --color-success: #006EFF;
    --color-warning: rgba(0, 110, 255, 0.75);
    --color-error: #FF4444;
    
    /* Text Colors */
    --text-primary: #FFFFFF;
    --text-secondary: #C9C9C9;
    --text-muted: #AAAAAA; /* Brightened from #8A8A8A */
    --text-dim: #888888;   /* Brightened from #5E5E5E */
    
    /* Borders */
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.16);

    /* Sizing */
    --header-height: 48px;
    --tab-height: 36px;
    --status-bar-height: 28px;
    --border-radius: 0px;
    --border-radius-sm: 0px;
    
    /* Layout */
    flex-grow: 1;
    background-color: var(--bg-dark);
    padding: 0;
    margin: 0;
}

/* ==================== Header ==================== */
.header {
    height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: var(--bg-secondary);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    flex-shrink: 0;
}

.header__logo-section {
    flex-direction: row;
    align-items: center;
}

.header__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
}

.header__version {
    font-size: 11px; /* Bumped from 10px */
    color: var(--text-muted);
    margin-left: 8px;
}

.header__actions {
    flex-direction: row;
    align-items: center; /* 세로 중앙 정렬 추가 */
    margin-left: auto;
}

.header__icon-button {
    height: 28px;
    min-width: 60px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 0;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    -unity-text-align: middle-center;
    font-size: 11px;
    color: var(--text-secondary);
}

.header__icon-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
}

/* ==================== Light Mode for MainWindow ==================== */
.theme-light .main-container {
    --varco-mint: #0066DD;
    --varco-blue: #1A6FDD;
    --varco-purple: #1B1F26;
    --varco-ink: #0B0F16;
    --varco-white: #FFFFFF;

    --bg-dark: #F4F6F9;
    --bg-secondary: #FFFFFF;
    --bg-card: #FFFFFF;
    --bg-elevated: #F7F8FB;
    --bg-control: #FFFFFF;
    --bg-control-hover: #EEF2F7;

    --color-success: #0066DD;
    --color-warning: rgba(0, 102, 221, 0.65);
    --color-error: #E53935;

    --text-primary: #1B1F26;
    --text-secondary: #4B5563;
    --text-muted: #6B7280;
    --text-dim: #8B93A1;

    --border-subtle: rgba(15, 23, 42, 0.12);
    --border-strong: rgba(15, 23, 42, 0.24);
}

.theme-light .main-container .header {
    background-color: #FFFFFF;
    border-bottom-color: rgba(0, 0, 0, 0.1);
}

.theme-light .main-container .header__title {
    color: #1A1A1A;
}

.theme-light .main-container .header__version {
    color: #777777;
}

.theme-light .main-container .header__icon-button {
    color: #555555;
    border-color: rgba(0, 0, 0, 0.15);
}

.theme-light .main-container .header__icon-button:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #1A1A1A;
}

.theme-light .main-container .tab-bar {
    background-color: #EEF2F7;
    border-bottom-color: rgba(0, 0, 0, 0.15);
}

.theme-light .main-container .tab-button {
    color: #555555;
}

.theme-light .main-container .tab-button--active {
    background-color: #FFFFFF;
    color: #0066DD;
}

.theme-light .main-container .content-area {
    background-color: #F4F6F9;
}


/* ==================== Tab Bar ==================== */
.tab-bar {
    height: 36px;
    flex-direction: row;
    padding-left: 16px;
    padding-right: 16px;
    background-color: var(--bg-secondary);
    border-bottom-width: 2px;
    border-bottom-color: var(--varco-mint);
    flex-shrink: 0;
}

.tab-button {
    flex-grow: 1;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-secondary);
    margin-left: 2px;
    margin-right: 2px;
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
}

.tab-button:hover {
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.05);
}

.tab-button--active {
    color: var(--varco-mint);
    border-bottom-color: var(--varco-mint);
}

.tab-button--active:hover {
    color: var(--varco-mint);
}

/* ==================== Content Area ==================== */
.content-area {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
    background-color: var(--bg-dark);
}

.panel {
    display: none;
    flex-grow: 1;
    background-color: var(--bg-dark);
    border-radius: 0;
    padding: 0;
    align-items: stretch;
}

.panel--active {
    display: flex;
}

.panel__placeholder {
    font-size: 32px;
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
    color: var(--text-secondary);
    margin-bottom: 8px;
}

.panel__description {
    font-size: 14px;
    color: var(--text-muted);
}

/* ==================== Status Bar ==================== */
.status-bar {
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: var(--bg-secondary);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
    flex-shrink: 0;
}

.status-bar__connection {
    flex-direction: row;
    align-items: center;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
}

.status-dot--connected {
    background-color: var(--color-success);
}

.status-dot--disconnected {
    background-color: var(--color-error);
}

.status-bar__text {
    font-size: 11px;
    color: var(--text-secondary);
}

.status-bar__info {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.status-bar__message {
    font-size: 11px;
    color: var(--text-muted);
}

/* ==================== Gradient Accent Line ==================== */
.gradient-line {
    height: 2px;
    background-color: var(--varco-mint);
}

/* ==================== Common Button Styles ==================== */
.btn-primary {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: var(--border-radius-sm);
    background-color: var(--varco-mint);
    border-width: 0;
    color: #FFFFFF; /* Unified White Text */
    font-size: 12px;
    -unity-font-style: bold;
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
}

.btn-primary:hover {
    background-color: var(--varco-blue);
    color: #FFFFFF;
}

.btn-secondary {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: var(--border-radius-sm);
    background-color: var(--bg-elevated);
    border-width: 1px;
    border-color: var(--text-muted);
    color: #FFFFFF; /* Unified White Text */
    font-size: 12px;
}

.btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
}

/* ==================== Card Styles ==================== */
.card {
    background-color: var(--bg-card);
    border-radius: var(--border-radius);
    padding: 16px;
    margin-bottom: 8px;
}

.card--selected {
    border-width: 1px;
    border-color: var(--varco-mint);
}

/* ==================== Section Header ==================== */
.section-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-primary);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
}

/* ==================== Panel Header (Standardized) ==================== */
.panel-header {
    height: 42px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 0;
    flex-shrink: 0;
}

.panel-header__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-text-align: middle-left;
    -unity-font: url('project://database/Packages/com.varco.voice/Runtime/Google_Sans_Flex/GoogleSansFlex-VariableFont_GRAD,ROND,opsz,slnt,wdth,wght.ttf');
}

.panel-header__controls {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.panel-header__controls > * {
    margin-left: 8px;
}

.dsp-header-btn {
    height: 24px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 13px;
    background-color: rgba(0, 110, 255, 0.2);
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(0, 110, 255, 0.4);
    color: var(--text-primary);
}

.dsp-header-btn:hover {
    background-color: rgba(0, 110, 255, 0.35);
}


/* Light Mode - Main Window Controls */
.theme-light .main-container .btn-secondary {
    background-color: #FFFFFF;
    border-color: rgba(15, 23, 42, 0.2);
    color: #4B5563;
}

.theme-light .main-container .btn-secondary:hover {
    background-color: #F3F6FB;
    color: #1B1F26;
}

.theme-light .main-container .tab-button:hover {
    background-color: rgba(15, 23, 42, 0.04);
}
