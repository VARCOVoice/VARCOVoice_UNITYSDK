<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- EQ Visualizer Panel: Spectrum Analyzer + Interactive EQ Nodes -->
    <ui:VisualElement name="eq-visualizer-panel" class="eq-visualizer-panel">
        <!-- Header -->
        <ui:VisualElement name="eq-header" class="eq-header">
            <ui:Label text="EQ / ANALYZER" class="section-title"/>
            <ui:VisualElement class="header-spacer"/>
            <ui:Button name="eq-clear-btn" text="Clear" class="eq-clear-btn"/>

        </ui:VisualElement>
        
        <!-- Main Content: Analyzer + Meters -->
        <ui:VisualElement name="eq-content" class="eq-content">
            <!-- Spectrum/EQ Canvas with Labels -->
            <ui:VisualElement name="spectrum-area" class="spectrum-area">
                <!-- dB Labels (Left side) -->
                <ui:VisualElement name="db-labels" class="db-labels">
                    <ui:Label text="+24" class="db-label"/>
                    <ui:Label text="+12" class="db-label"/>
                    <ui:Label text="0dB" class="db-label center"/>
                    <ui:Label text="-12" class="db-label"/>
                    <ui:Label text="-24" class="db-label"/>
                </ui:VisualElement>
                
                <!-- Main Canvas -->
                <ui:VisualElement name="spectrum-canvas" class="spectrum-canvas">
                    <!-- EQ Nodes will be added here dynamically -->
                    <ui:VisualElement name="eq-nodes-container" class="eq-nodes-container"/>
                </ui:VisualElement>
                
                <!-- Level Meters (Right side) -->
                <ui:VisualElement name="meters-panel" class="meters-panel">
                    <ui:Label text="LEVEL" class="meters-title"/>
                    <ui:VisualElement class="meters-bars">
                        <ui:VisualElement name="meter-left" class="meter-bar">
                            <ui:VisualElement name="meter-left-fill" class="meter-fill"/>
                            <ui:VisualElement name="meter-left-peak" class="meter-peak"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="meter-right" class="meter-bar">
                            <ui:VisualElement name="meter-right-fill" class="meter-fill"/>
                            <ui:VisualElement name="meter-right-peak" class="meter-peak"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="meter-readouts">
                         <ui:Label name="meter-left-value" text="-inf" class="meter-val"/>
                         <ui:Label name="meter-right-value" text="-inf" class="meter-val"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="meter-labels">
                        <ui:Label text="L" class="meter-label"/>
                        <ui:Label text="R" class="meter-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Frequency Labels (Bottom) -->
            <ui:VisualElement name="freq-labels" class="freq-labels">
                <!-- Labels will be generated by EQVisualizerController -->
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
